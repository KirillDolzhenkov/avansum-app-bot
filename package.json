{
  "name": "avansum-app",
  "version": "1.0.0",
  "description": "Telegram-бот, который превращает заявку на окна в свободной форме в структурированные данные",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "dotenv": "^18.0.10",
    "grammy": "^1.48.0",
    "libphonenumber-js": "^1.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
