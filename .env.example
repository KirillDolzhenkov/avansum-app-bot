BOT_TOKEN=

# AI-провайдер: gemini (по умолчанию) или openai (любой OpenAI-совместимый API: Groq, Cerebras, Mistral, OpenRouter)
AI_PROVIDER=

# --- AI_PROVIDER=gemini ---
GEMINI_API_KEY=
# Необязательно, по умолчанию gemini-3.8-flash
GEMINI_MODEL=

# --- AI_PROVIDER=openai ---
AI_API_KEY=
# Необязательно, по умолчанию https://api.groq.com/openai/v1
AI_BASE_URL=
# Необязательно, по умолчанию openai/gpt-oss-120b
AI_MODEL=
# Необязательно: low | medium | high. Для gpt-oss рекомендуется low — меньше токенов, быстрее ответ
AI_REASONING_EFFORT=
