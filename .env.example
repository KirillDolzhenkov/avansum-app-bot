BOT_TOKEN=

# AI-провайдер: openai (по умолчанию; любой OpenAI-совместимый API — Groq, Cerebras, Mistral, OpenRouter) или gemini
AI_PROVIDER=
# Ключ выбранного провайдера (для Groq начинается с gsk_)
AI_API_KEY=
# Необязательно. По умолчанию openai/gpt-oss-120b для openai и gemini-3.8-flash для gemini
AI_MODEL=

# --- Только для AI_PROVIDER=openai ---
# Необязательно, по умолчанию https://api.groq.com/openai/v1
AI_BASE_URL=
# Необязательно: low | medium | high. Для gpt-oss рекомендуется low — меньше токенов, быстрее ответ
AI_REASONING_EFFORT=
